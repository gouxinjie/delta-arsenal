# 站点根地址（生产构建必填）
# 用于 canonical / OpenGraph / sitemap.xml / robots.txt 的绝对 URL；
# 未设置时回退 http://localhost:3000，仅适合本地开发。
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# 改枪码写入口令（生产必填，否则 /api/builds 一律拒绝写入）
# 录入器里填同一串口令即可入库；建议 32 位以上随机字符串，不要复用其他口令
BUILDS_WRITE_TOKEN=change-me-to-a-long-random-string
